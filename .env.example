# Copy this file to ".env" and fill in the values from your own Supabase project.
# ".env" is ignored by git. NEVER commit it, paste it in chat, or put these values in a web page.

# Project Settings -> API -> Project URL
SUPABASE_URL=

# The public key (labelled "anon" or "publishable"). Safe for the browser.
SUPABASE_PUBLIC_KEY=

# The secret key (labelled "service_role" or "secret"). Server only! Full access to all data.
SUPABASE_SECRET_KEY=

# Long random text used to sign login cookies. Make up a long random string.
SECRET_KEY=

# Optional. Comma-separated invite codes, e.g. friends2026,hostel-batch. When set, sign-up needs one.
# Leave empty on your own computer; set it on the live site so only invited people can join.
INVITE_CODES=
